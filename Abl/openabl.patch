+STATIC EFI_STATUS
+PonOffModeCharging (BOOLEAN *BatteryStatus)
+{
+  EFI_STATUS Status;
+  EFI_PM_PON_REASON_TYPE PONReason;
+  EFI_QCOM_PMIC_PON_PROTOCOL *PmicPonProtocol;
+  BOOLEAN WarmRtStatus;
