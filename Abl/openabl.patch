+
+  Status = PmicPonProtocol->WarmResetStatus (0, &WarmRtStatus);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((EFI_D_ERROR, "Error getting warm reset status: %r\n", Status));
+    return Status;
+  }
+
+  DEBUG ((EFI_D_INFO, " PON Reason is 0x%x cold_boot:%d\n",
+          *(UINT8 *)&PONReason, !WarmRtStatus));
+  *BatteryStatus = !WarmRtStatus && !PONReason.HARD_RESET &&
+                   !PONReason.KPDPWR &&
+                   (PONReason.CBLPWR || PONReason.USB_CHG || PONReason.PON1);
+  return EFI_SUCCESS;
+}
