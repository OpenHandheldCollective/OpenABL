+/* OpenABL: BootLinux's pvmfw steps, for boot images the menu lays out:
+ * pvmfw goes into its golden region and is registered with the resource
+ * manager. */
+EFI_STATUS
+OpenAblPvmFwRegister (BootInfo *Info)
+{
+  BootParamlist Params = {0};
+  EFI_STATUS    Status;
+
+  if (!Info->HasPvmFw) {
+    return EFI_NOT_FOUND;
+  }
+  if (!QueryPvmFwParams (&Params.PvmFwLoadAddr, &Params.PvmFwSizeReserved) ||
+      (Params.PvmFwLoadAddr == 0)) {
+    return EFI_NOT_FOUND;
+  }
+  Status = GetImage (Info, &Params.PvmFwBuffer,
+                     (UINTN *)&Params.PvmFwBufferSize, "pvmfw");
+  if (Status || (Params.PvmFwBufferSize <= 0)) {
+    return EFI_LOAD_ERROR;
+  }
+  if (Info->PvmFwSizeActual > Params.PvmFwSizeReserved) {
+    return EFI_BUFFER_TOO_SMALL;
+  }
+  gBS->CopyMem ((CHAR8 *)Params.PvmFwLoadAddr,
+                Params.PvmFwBuffer + BOOT_IMG_MAX_PAGE_SIZE,
+                Info->PvmFwSizeActual);
+  Status = AppendPvmFwConfig (Info, &Params);
+  if (Status == EFI_SUCCESS) {
+    Status = RmRegisterPvmFwRegion (Info, &Params);
+  }
+  return Status;
+}
