+
+  FastbootTextMenuLoop ();
+
+  return FastbootStop ();
+}
+
+EFI_STATUS
+FastbootStop (VOID)
+{
+  EFI_STATUS Status;
+
+  if (mGadgetPaused) {
+    /* A second Stop() would double-free in XBL. */
+    ExitMenuKeysDetection ();
+    return EFI_SUCCESS;
   }
 
   /* Close the fastboot app and stop USB device */
