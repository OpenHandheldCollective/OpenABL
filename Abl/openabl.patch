+                                (VOID **)&PmicPonProtocol);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((EFI_D_ERROR, "Error locating pmic pon protocol: %r\n", Status));
+    return Status;
+  }
+
+  Status = PmicPonProtocol->GetPonReason (0, &PONReason);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((EFI_D_ERROR, "Error getting pon reason: %r\n", Status));
+    return Status;
