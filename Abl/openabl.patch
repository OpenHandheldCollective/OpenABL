+/* The gadget off and on, for USB host. Stop() first so no transfer is in
+ * flight; XBL's Stop() never twice without a StartEx between. */
+EFI_STATUS
+FastbootGadget (IN BOOLEAN On)
+{
+  EFI_STATUS Status;
+
+  if (!On) {
+    if (!mFastbootUsbStarted) {
+      return EFI_SUCCESS;
+    }
+    Status = Fbd.UsbDeviceProtocol->Stop ();
+    DEBUG ((EFI_D_ERROR, "Fastboot: gadget paused for USB host: %r\n", Status));
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+    mGadgetPaused = TRUE;
+    return FastbootUsbDeviceStop ();
+  }
+  if (!mGadgetPaused) {
+    return EFI_SUCCESS;
+  }
+  Status = FastbootUsbDeviceStart (TRUE);
+  DEBUG ((EFI_D_ERROR, "Fastboot: gadget back: %r\n", Status));
+  if (!EFI_ERROR (Status)) {
+    mGadgetPaused = FALSE;
+  }
+  return Status;
+}
