# Stages OpenABL images on the ESP for OpenABL to install on the next boot
# into Linux. Takes images or folders of them, like an unpacked release.
# Booted through OpenABL, it only stages this chip's image.
#
#   openabl-update [--esp DIR] [--force] IMAGE.elf|DIR...
#   openabl-update [--esp DIR] --cancel
#   openabl-update --status

set -eu

ESRT=/sys/firmware/efi/esrt/entries/entry0
# OpenABL's ESRT class, minus the chip id on the end.
CLASS=c02d2ab2-3223-42be-9608-e280

die() { echo "openabl-update: $*" >&2; exit 1; }

usage() {
  echo "usage: openabl-update [--esp DIR] [--force] IMAGE.elf|DIR..." >&2
  echo "       openabl-update [--esp DIR] --cancel" >&2
  echo "       openabl-update --status" >&2
  exit 2
}

pair() { echo "$(($1 >> 16)).$(($1 & 0xffff))"; }

status_name() {
  case $1 in
    0) echo "success" ;;
    1) echo "unsuccessful (see OpenABL's log)" ;;
    2) echo "too large for the abl partition" ;;
    3) echo "not newer than the installed version (use --force)" ;;
    4) echo "not a valid image for this device" ;;
    5) echo "damaged: its SHA-256 doesn't match" ;;
    7) echo "battery too low; it stays staged for the next boot" ;;
    *) echo "status $1" ;;
  esac
}

# The chip id from the end of the ESRT class, empty if not booted through
# OpenABL.
chip() {
  class=$(cat "$ESRT/fw_class" 2> /dev/null) || return 0
  case $class in
    "$CLASS"*) ;;
    *) return 0 ;;
  esac
  le=${class#"$CLASS"}
  echo $((0x$(echo "$le" | sed 's/\(..\)\(..\)\(..\)\(..\)/\4\3\2\1/')))
}

status() {
  [ -r "$ESRT/fw_class" ] || die "no ESRT: not booted through OpenABL"
  case $(cat "$ESRT/fw_class") in
    "$CLASS"*) ;;
    *) die "the ESRT's firmware isn't OpenABL's ($(cat "$ESRT/fw_class"))" ;;
  esac
  echo "chip:         $(chip)"
  echo "installed:    $(pair "$(cat "$ESRT/fw_version")")"
  echo "last attempt: $(pair "$(cat "$ESRT/last_attempt_version")"), $(status_name "$(cat "$ESRT/last_attempt_status")")"
}

find_esp() {
  if [ -n "$ESP" ]; then
    [ -d "$ESP" ] || die "$ESP isn't a directory"
    return
  fi
  ESP=$(bootctl --print-esp-path 2> /dev/null || :)
  [ -n "$ESP" ] && return
  for dir in /efi /boot/efi /boot; do
    if [ "$(findmnt -n -o FSTYPE --target "$dir" 2> /dev/null)" = vfat ]; then
      ESP=$dir
      return
    fi
  done
  die "no EFI system partition found; pass --esp"
}

# Where the image tag starts in FILE, if it has exactly one.
tag_at() {
  at=$(LC_ALL=C grep -a -b -o OABLIMG1 "$1" 2> /dev/null | cut -d: -f1)
  [ "$(echo "$at" | wc -w)" = 1 ] && echo "$at"
}

# tag FILE OFFSET: a text field from the image tag, empty if there's none.
tag() {
  at=$(tag_at "$1") || return 0
  dd if="$1" bs=1 skip=$((at + 8 + $2)) count=16 2> /dev/null | tr -d '\000'
}

# The ChipInfo ids the image is built for.
chips() {
  at=$(tag_at "$1") || return 0
  count=$(od -An -tu4 -j $((at + 40)) -N 4 "$1" | tr -d ' ')
  [ "${count:-0}" -ge 1 ] && [ "$count" -le 32 ] || return 0
  od -An -v -tu4 -j $((at + 44)) -N $((4 * count)) "$1" | tr -s ' \n' '  '
}

ESP="" FORCE=0 CANCEL=0 ARGS=""
while [ $# -gt 0 ]; do
  case $1 in
    --esp) [ $# -ge 2 ] || usage; ESP=$2; shift ;;
    --force) FORCE=1 ;;
    --cancel) CANCEL=1 ;;
    --status) status; exit 0 ;;
    -*) usage ;;
    *) ARGS=1; break ;;
  esac
  shift
done
[ "$CANCEL" = 1 ] || [ -n "$ARGS" ] || usage

find_esp
DIR=$ESP/openabl/update

if [ "$CANCEL" = 1 ]; then
  rm -f "$DIR"/*.elf "$DIR"/*.elf.sha256 "$DIR"/force
  sync
  echo "openabl-update: nothing staged on $ESP"
  exit 0
fi

# Queues an image unless it's for another chip.
add() {
  if [ -f "$1.sha256" ]; then
    [ "$(cut -d' ' -f1 "$1.sha256")" = "$(sha256sum "$1" | cut -d' ' -f1)" ] ||
      die "$1 doesn't match $1.sha256"
  fi
  [ -n "$(chips "$1")" ] || die "$1 has no image tag (too old?)"
  if [ -n "$CHIP" ]; then
    case " $(chips "$1") " in
      *" $CHIP "*) ;;
      *) return 0 ;;
    esac
  fi
  IMAGES="$IMAGES$1
"
}

CHIP=$(chip)
IMAGES=""
for arg in "$@"; do
  if [ -d "$arg" ]; then
    found=""
    for image in "$arg"/*.elf "$arg"/*/*.elf; do
      [ -f "$image" ] || continue
      found=1
      add "$image"
    done
    [ -n "$found" ] || die "no .elf images in $arg"
  else
    case $arg in
      *.elf) ;;
      *) die "$arg isn't an .elf image" ;;
    esac
    [ -f "$arg" ] || die "$arg doesn't exist"
    add "$arg"
  fi
done
[ -n "$IMAGES" ] || die "none of the images is built for this chip ($CHIP)"

mkdir -p "$DIR"
rm -f "$DIR"/*.elf "$DIR"/*.elf.sha256 "$DIR"/force
set -f
IFS='
'
for image in $IMAGES; do
  name=$(basename "$image")
  cp "$image" "$DIR/$name.tmp"
  mv "$DIR/$name.tmp" "$DIR/$name"
  echo "$(sha256sum "$image" | cut -d' ' -f1)  $name" > "$DIR/$name.sha256"
  echo "openabl-update: staged $(tag "$image" 0) $(tag "$image" 16) ($name)"
done
if [ "$FORCE" = 1 ]; then
  : > "$DIR/force"
fi
sync
echo "openabl-update: reboot into Linux to install it from $ESP"
